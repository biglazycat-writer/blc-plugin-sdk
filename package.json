{
  "name": "blc-plugin-sdk",
  "version": "1.8.0",
  "description": "大懒猫写作插件 SDK v1：类型定义、清单 schema 与宿主桥接入口",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22.23.3 <23.0.0"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    },
    "./browser": {
      "types": "./browser.d.ts",
      "import": "./browser.mjs"
    },
    "./manifest.schema.json": "./manifest.schema.json"
  },
  "files": [
    "FEATURES.md",
    "AI.md",
    "CAPABILITIES.md",
    "*.mjs",
    "*.d.ts",
    "manifest.schema.json",
    "README*.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs && npm run typecheck",
    "typecheck": "tsc -p tests/tsconfig.json"
  },
  "keywords": [
    "biglazycat",
    "plugin",
    "sdk",
    "大懒猫写作"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biglazycat-writer/blc-plugin-sdk.git"
  },
  "homepage": "https://github.com/biglazycat-writer/blc-plugin-sdk#readme",
  "bugs": {
    "url": "https://github.com/biglazycat-writer/blc-plugin-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
